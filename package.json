{
  "name": "fast-wikidot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/index.tsx",
    "build": "tsx scripts/build.ts",
    "setup": "tsx scripts/setup.ts",
    "start": "node dist/core.cjs",
    "typecheck": "tsc",
    "format": "oxfmt && go fmt scripts/cli.go",
    "lint": "oxlint --fix && go fix scripts/cli.go",
    "fix": "pnpm format && pnpm lint && pnpm typecheck"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.16",
    "open": "^11.0.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.18.0"
}
