{
  "name": "fast-wikidot",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "fastwd": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch ./src/index.tsx",
    "build": "esbuild ./src/index.tsx --outfile=./dist/index.js --bundle --minify --platform=node --format=cjs",
    "start": "node ./dist/index.js",
    "fmt": "oxfmt",
    "lint": "oxlint"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "tsx": "^4.23.15",
    "typescript": "^7"
  },
  "packageManager": "pnpm@12.10.1"
}
